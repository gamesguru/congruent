[submodule "complement-src"]
	path = complement-src
	url = https://github.com/gamesguru/complement
[submodule "spec"]
	path = spec
	url = https://github.com/wombat-foundation/matrix-spec.git
[submodule "complement-crypto-src"]
	path = complement-crypto-src
	url = https://github.com/wombat-foundation/complement-crypto
[submodule "mtx-slipstream"]
	path = mtx-slipstream
	url = https://github.com/Wombat-Foundation/mtx-slipstream.git
[submodule "res"]
	path = res
	url = git@gitlab.com:gamesguru/congruent-res.git
	# override locally with: git config set submodule.res.update checkout
	update = none
